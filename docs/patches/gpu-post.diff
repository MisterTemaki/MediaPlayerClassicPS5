+	s.motion = pv.st_active && pv.st_motion;
+	if (pv.st_frames)
+	{
+		s.prep_ms = pv.st_ms[0] / pv.st_frames;
+		s.motion_ms = pv.st_ms[1] / pv.st_frames;
+		s.scale_ms = pv.st_ms[2] / pv.st_frames;
