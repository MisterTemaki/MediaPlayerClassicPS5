diff --git a/shaders/easu.comp b/shaders/easu.comp
new file mode 100644
index 0000000..b101f3d
--- /dev/null
+++ b/shaders/easu.comp
@@ -0,0 +1,68 @@
+// ps5-slang-gpu 1.2 (Media Player Classic PS5 1.7): the video post-processing's FSR 1 scaler (docs/POST-PROCESSING.md):
+// AMD FidelityFX Super Resolution 1.0's EASU (edge-adaptive spatial upsampling), third_party/ffx-fsr1 (MIT, unchanged),
+// wired as AMD's Vulkan sample wires it (sample/src/VK/FSR_Pass.glsl): 64 invocations make a 16x16 tile, four pixels
+// each, the input read through textureGather. POST_FP16: FSR's half-precision EASU (FsrEasuH). Only the rectangle's
+// part on the display is made (pc.offset: that part's corner in the rectangle). Its sharpening, RCAS, is in post.frag.
+//
+// SPDX-License-Identifier: MIT
+#version 450
+#extension GL_GOOGLE_include_directive : require
+
+layout(set = 0, binding = 0) uniform sampler2D Src; // A2B10G10R10, linear, clamped
+layout(set = 0, binding = 1, rgb10_a2) uniform writeonly image2D Dst;
+
+layout(push_constant) uniform Pc
+{
+	uvec4 con0, con1, con2, con3; // FsrEasuCon's, made on the CPU (gpu.cpp, EasuConstants)
+	ivec4 area;                   // the visible part's corner in the rectangle (x, y), its width and height
+}
+pc;
+
+#define A_GPU 1
+#define A_GLSL 1
+#ifdef POST_FP16
+#define A_HALF 1
+#endif
+#include "../third_party/ffx-fsr1/ffx_a.h"
+
+#ifdef POST_FP16
+#define FSR_EASU_H 1
+AH4 FsrEasuRH(AF2 p) { return AH4(textureGather(Src, p, 0)); }
+AH4 FsrEasuGH(AF2 p) { return AH4(textureGather(Src, p, 1)); }
+AH4 FsrEasuBH(AF2 p) { return AH4(textureGather(Src, p, 2)); }
+#else
+#define FSR_EASU_F 1
+AF4 FsrEasuRF(AF2 p) { return textureGather(Src, p, 0); }
+AF4 FsrEasuGF(AF2 p) { return textureGather(Src, p, 1); }
+AF4 FsrEasuBF(AF2 p) { return textureGather(Src, p, 2); }
+#endif
+#include "../third_party/ffx-fsr1/ffx_fsr1.h"
+
+void Filter(AU2 pos)
+{
+	if (int(pos.x) >= pc.area.z || int(pos.y) >= pc.area.w)
+		return;
+	const AU2 ip = pos + AU2(pc.area.xy);
+#ifdef POST_FP16
+	AH3 c;
+	FsrEasuH(c, ip, pc.con0, pc.con1, pc.con2, pc.con3);
+	imageStore(Dst, ASU2(pos), vec4(vec3(c), 1.0));
+#else
+	AF3 c;
+	FsrEasuF(c, ip, pc.con0, pc.con1, pc.con2, pc.con3);
+	imageStore(Dst, ASU2(pos), vec4(clamp(c, 0.0, 1.0), 1.0));
+#endif
+}
+
+layout(local_size_x = 64) in;
+void main()
+{
+	AU2 gxy = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
+	Filter(gxy);
+	gxy.x += 8u;
+	Filter(gxy);
+	gxy.y += 8u;
+	Filter(gxy);
+	gxy.x -= 8u;
+	Filter(gxy);
+}
diff --git a/shaders/flow.comp b/shaders/flow.comp
new file mode 100644
index 0000000..86313ce
--- /dev/null
+++ b/shaders/flow.comp
@@ -0,0 +1,103 @@
+// ps5-slang-gpu 1.2 (Media Player Classic PS5 1.7): motion smoothing's optical flow, one level of the pyramid, one way
+// (docs/POST-PROCESSING.md). Coarse to fine: each pixel's vector from picture A to picture B starts from the coarser
+// level's (doubled, the median of five around it: a stray vector doesn't spread), or from this level's last pass, or
+// from zero at the coarsest; it is then refined by a +-1 pixel search around it, a 5x5 patch's sum of absolute
+// differences (with a small pull towards the starting vector, so flat areas keep it), and a parabola through the best
+// cost and its neighbours for the sub-pixel part. Vectors in this level's pixels, R16G16_SFLOAT.
+//
+// SPDX-License-Identifier: MIT
+#version 450
+#extension GL_GOOGLE_include_directive : require
+#include "post_common.glsl"
+
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform sampler2D A;    // this level, linear, clamped
+layout(set = 0, binding = 1) uniform sampler2D B;    // this level of the other picture
+layout(set = 0, binding = 2) uniform sampler2D Prev; // the starting vectors (the coarser level, or this one)
+layout(set = 0, binding = 3, rg16f) uniform writeonly image2D Dst;
+
+layout(push_constant) uniform Pc
+{
+	ivec4 mode; // 0: from zero, 1: from the coarser level (doubled), 2: from this level's last pass; width, height
+	vec4 tune;  // the pull towards the starting vector (per pixel of difference), 0, 0, 0
+}
+pc;
+
+hf Sad(vec2 pa, vec2 pb, vec2 inv)
+{
+	hf s = hf(0.0);
+	for (int j = -2; j <= 2; j++)
+		for (int i = -2; i <= 2; i++)
+		{
+			const vec2 o = vec2(i, j);
+			s += abs(hf(textureLod(A, (pa + o) * inv, 0.0).r) - hf(textureLod(B, (pb + o) * inv, 0.0).r));
+		}
+	return s;
+}
+
+float Med3(float a, float b, float c)
+{
+	return max(min(a, b), min(max(a, b), c));
+}
+
+// the median of five values
+float Med5(float a, float b, float c, float d, float e)
+{
+	const float f = max(min(a, b), min(c, d));
+	const float g = min(max(a, b), max(c, d));
+	return Med3(e, f, g);
+}
+
+vec2 Start(ivec2 p, ivec2 size)
+{
+	if (pc.mode.x == 0)
+		return vec2(0.0);
+	const ivec2 psize = textureSize(Prev, 0);
+	const float k = pc.mode.x == 1 ? 2.0 : 1.0;
+	const vec2 c = (vec2(p) + 0.5) / k; // where this pixel falls in the starting level
+	vec2 v[5];
+	const vec2 offs[5] = vec2[5](vec2(0, 0), vec2(-1, 0), vec2(1, 0), vec2(0, -1), vec2(0, 1));
+	for (int n = 0; n < 5; n++)
+		v[n] = textureLod(Prev, (c + offs[n]) / vec2(psize), 0.0).rg;
+	return k * vec2(Med5(v[0].x, v[1].x, v[2].x, v[3].x, v[4].x), Med5(v[0].y, v[1].y, v[2].y, v[3].y, v[4].y));
+}
+
+void main()
+{
+	const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+	const ivec2 size = pc.mode.yz;
+	if (p.x >= size.x || p.y >= size.y)
+		return;
+	const vec2 inv = 1.0 / vec2(size);
+	const vec2 pa = vec2(p) + 0.5;
+	const vec2 v0 = Start(p, size);
+	const hf pull = hf(pc.tune.x);
+	hf cost[9];
+	int best = 4;
+	for (int j = -1; j <= 1; j++)
+		for (int i = -1; i <= 1; i++)
+		{
+			const int k = (j + 1) * 3 + (i + 1);
+			cost[k] = Sad(pa, pa + v0 + vec2(i, j), inv) + pull * hf(abs(i) + abs(j));
+			if (cost[k] < cost[best])
+				best = k;
+		}
+	const int bi = best % 3 - 1, bj = best / 3 - 1;
+	vec2 d = vec2(bi, bj);
+	// the sub-pixel part: a parabola through the best cost and its two neighbours, each way, when both are there
+	if (bi == 0)
+	{
+		const float l = float(cost[best - 1]), c = float(cost[best]), r = float(cost[best + 1]);
+		const float den = l - 2.0 * c + r;
+		if (den > 1e-6)
+			d.x += clamp(0.5 * (l - r) / den, -0.5, 0.5);
+	}
+	if (bj == 0)
+	{
+		const float u = float(cost[best - 3]), c = float(cost[best]), w = float(cost[best + 3]);
+		const float den = u - 2.0 * c + w;
+		if (den > 1e-6)
+			d.y += clamp(0.5 * (u - w) / den, -0.5, 0.5);
+	}
+	imageStore(Dst, p, vec4(v0 + d, 0.0, 0.0));
+}
diff --git a/shaders/post.frag b/shaders/post.frag
new file mode 100644
index 0000000..52bc93f
--- /dev/null
+++ b/shaders/post.frag
@@ -0,0 +1,75 @@
+// ps5-slang-gpu 1.2 (Media Player Classic PS5 1.7): the video post-processing's last pass, a fragment shader in the
+// frame's render pass under the UI surface (docs/POST-PROCESSING.md; the quad: video.vert). Each pixel of the picture's
+// part on the display, from the image the compute passes made (the scaler's at the display's size, or the picture's own
+// when it is shown at its size), in this order:
+//   1. FSR 1's RCAS sharpening when FSR 1 scaled it (third_party/ffx-fsr1, MIT; the strength in stops);
+//   2. to the display: tone mapping of an HDR picture to SDR (BT.2390, Hable, Reinhard: as video.frag), or HDR10 output;
+//   3. MPC-HC's colour controls (brightness, contrast, saturation) on the result's codes.
+//
+// SPDX-License-Identifier: MIT
+#version 450
+#extension GL_GOOGLE_include_directive : require
+#include "post_common.glsl"
+
+layout(location = 0) in vec2 Tc;
+layout(location = 0) out vec4 FragColor;
+layout(set = 0, binding = 0) uniform sampler2D Img; // A2B10G10R10, read with texelFetch (its part pc.tone.yz)
+
+layout(push_constant) uniform Pc
+{
+	layout(offset = 16) ivec4 area; // the image's corner on the display (x, y), flags (1 RCAS, 2 HDR10 out), transfer
+	ivec4 tone;                     // the curve (0 off, 1 BT.2390, 2 Hable, 3 Reinhard); the image's part read (w, h), 0
+	vec4 color;                     // brightness (-1..1), contrast (0..2), saturation (0..2), 0
+	uvec4 rcas;                     // FsrRcasCon's
+	vec4 tm;                        // the curve's top (nits), the white (nits), 1 / white, 0
+	vec4 pq;                        // BT.2390: PqInv(top), PqInv(white) / PqInv(top), ks, 0
+}
+pc;
+
+ivec2 gSize; // the part of the image the passes wrote (it can be larger: made once at the display's size)
+
+#define A_GPU 1
+#define A_GLSL 1
+#ifdef POST_FP16
+#define A_HALF 1
+#endif
+#include "../third_party/ffx-fsr1/ffx_a.h"
+#ifdef POST_FP16
+#define FSR_RCAS_H 1
+AH4 FsrRcasLoadH(ASW2 p) { return AH4(texelFetch(Img, clamp(ivec2(p), ivec2(0), gSize - 1), 0)); }
+void FsrRcasInputH(inout AH1 r, inout AH1 g, inout AH1 b) {}
+#else
+#define FSR_RCAS_F 1
+AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(Img, clamp(ivec2(p), ivec2(0), gSize - 1), 0); }
+void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
+#endif
+#include "../third_party/ffx-fsr1/ffx_fsr1.h"
+
+void main()
+{
+	gSize = max(min(pc.tone.yz, textureSize(Img, 0)), ivec2(1));
+	const ivec2 p = clamp(ivec2(gl_FragCoord.xy) - pc.area.xy, ivec2(0), gSize - 1);
+	vec3 c;
+	if ((pc.area.z & 1) != 0)
+	{
+#ifdef POST_FP16
+		AH1 r, g, b;
+		FsrRcasH(r, g, b, AU2(p), pc.rcas);
+		c = vec3(r, g, b);
+#else
+		AF1 r, g, b;
+		FsrRcasF(r, g, b, AU2(p), pc.rcas);
+		c = vec3(r, g, b);
+#endif
+		c = clamp(c, 0.0, 1.0);
+	}
+	else
+		c = texelFetch(Img, p, 0).rgb;
+	const int transfer = pc.area.w;
+	if ((pc.area.z & 2) != 0)
+		c = PostToHdr10(c, transfer);
+	else if (transfer != kPostSdr && pc.tone.x != kPostTmOff)
+		c = PostToneMap(c, transfer, pc.tone.x, pc.tm, pc.pq);
+	c = PostColor(c, pc.color.x, pc.color.y, pc.color.z);
+	FragColor = vec4(c, 1.0);
+}
diff --git a/shaders/post_common.glsl b/shaders/post_common.glsl
new file mode 100644
index 0000000..df21491
--- /dev/null
+++ b/shaders/post_common.glsl
@@ -0,0 +1,153 @@
+// ps5-slang-gpu 1.2 (Media Player Classic PS5 1.7): what the video post-processing passes share (docs/POST-PROCESSING.md
+// in the player's repository). Included by prep.comp, pyr.comp, flow.comp, warp.comp, scale.comp, easu.comp and
+// post.frag (glslangValidator -I shaders).
+//
+// POST_FP16 (the FP16 build of a pass, used when the device has shaderFloat16 and shaderInt16): `hf` and friends are
+// float16_t, else float. Only arithmetic is half: images are read and written as float.
+//
+// SPDX-License-Identifier: MIT
+#ifndef POST_COMMON_GLSL
+#define POST_COMMON_GLSL
+
+#ifdef POST_FP16
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#define hf float16_t
+#define hf2 f16vec2
+#define hf3 f16vec3
+#define hf4 f16vec4
+#else
+#define hf float
+#define hf2 vec2
+#define hf3 vec3
+#define hf4 vec4
+#endif
+
+// BT.709 luma (for a picture's motion and its banding: the exact weights don't matter there)
+const vec3 kLuma = vec3(0.2126, 0.7152, 0.0722);
+
+// Integer hash (a pixel's own random numbers, the same each run: the tests compare pictures)
+uint PostHash(uvec3 v)
+{
+	uint h = v.x * 0x8da6b343u ^ v.y * 0xd8163841u ^ v.z * 0xcb1ab31fu;
+	h ^= h >> 16;
+	h *= 0x7feb352du;
+	h ^= h >> 15;
+	h *= 0x846ca68bu;
+	h ^= h >> 16;
+	return h;
+}
+
+float PostRand(uvec3 v) // 0..1
+{
+	return float(PostHash(v) >> 8) * (1.0 / 16777216.0);
+}
+
+// ---- transfer functions and tone mapping: the same numbers as video.frag (and the player's CPU path) ----------------
+float PostPqEotf(float e) // signal 0..1 -> nits
+{
+	const float m1 = 0.1593017578125, m2 = 78.84375, c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;
+	const float p = pow(max(e, 0.0), 1.0 / m2);
+	return 10000.0 * pow(max(p - c1, 0.0) / (c2 - c3 * p), 1.0 / m1);
+}
+
+float PostPqInv(float nits) // nits -> signal 0..1
+{
+	const float m1 = 0.1593017578125, m2 = 78.84375, c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;
+	const float y = pow(max(nits, 0.0) / 10000.0, m1);
+	return pow((c1 + c2 * y) / (1.0 + c3 * y), m2);
+}
+
+float PostHlgInvOetf(float e) // signal 0..1 -> scene light 0..1
+{
+	const float a = 0.17883277, b = 0.28466892, c = 0.55991073;
+	return e <= 0.5 ? e * e / 3.0 : (exp((e - c) / a) + b) / 12.0;
+}
+
+float PostHable(float x)
+{
+	const float A = 0.15, B = 0.50, C = 0.10, D = 0.20, E = 0.02, F = 0.30;
+	return (x * (A * x + C * B) + D * E) / (x * (A * x + B) + D * F) - E / F;
+}
+
+const int kPostSdr = 0, kPostPq = 1, kPostHlg = 2;
+const int kPostTmOff = 0, kPostBt2390 = 1, kPostHable = 2, kPostReinhard = 3;
+
+// nits in -> nits out, from [0, top] to [0, white]; tm: top, white, 1 / white; pq: BT.2390's PqInv(top),
+// PqInv(white) / PqInv(top), ks
+float PostCurve(float L, int curve, vec4 tm, vec4 pq)
+{
+	const float top = tm.x, white = tm.y;
+	if (L <= 0.0)
+		return 0.0;
+	if (top <= white)
+		return L;
+	if (curve == kPostHable)
+		return white * PostHable(L / white * 2.0) / PostHable(top / white * 2.0);
+	if (curve == kPostReinhard)
+	{
+		const float x = L / white, lw2 = (top / white) * (top / white);
+		return white * x * (1.0 + x / lw2) / (1.0 + x);
+	}
+	const float src = pq.x, max_lum = pq.y, ks = pq.z;
+	const float e1 = PostPqInv(L) / src;
+	float e2 = e1;
+	if (e1 > ks && ks < 1.0)
+	{
+		const float t = (e1 - ks) / (1.0 - ks), t2 = t * t, t3 = t2 * t;
+		e2 = (2.0 * t3 - 3.0 * t2 + 1.0) * ks + (t3 - 2.0 * t2 + t) * (1.0 - ks) + (-2.0 * t3 + 3.0 * t2) * max_lum;
+	}
+	return PostPqEotf(min(e2, 1.0) * src);
+}
+
+// an HDR signal (PQ or HLG, BT.2020) to SDR R'G'B' (BT.709, gamma 2.4), as video.frag's ToneMap
+vec3 PostToneMap(vec3 e, int transfer, int curve, vec4 tm, vec4 pq)
+{
+	vec3 lin;
+	if (transfer == kPostHlg)
+	{
+		lin = vec3(PostHlgInvOetf(e.r), PostHlgInvOetf(e.g), PostHlgInvOetf(e.b));
+		const float ys = dot(lin, vec3(0.2627, 0.6780, 0.0593));
+		lin *= 1000.0 * pow(clamp(ys, 0.0, 1.0), 0.2);
+	}
+	else
+		lin = vec3(PostPqEotf(e.r), PostPqEotf(e.g), PostPqEotf(e.b));
+	vec3 c = vec3(dot(vec3(1.6605, -0.5876, -0.0728), lin), dot(vec3(-0.1246, 1.1329, -0.0083), lin),
+		dot(vec3(-0.0182, -0.1006, 1.1187), lin));
+	c = max(c, vec3(0.0));
+	const float mx = min(max(c.r, max(c.g, c.b)), tm.x);
+	const float gain = mx > 0.0 ? PostCurve(mx, curve, tm, pq) / mx * tm.z : tm.z;
+	c = min(c * gain, vec3(1.0));
+	return pow(c, vec3(1.0 / 2.4));
+}
+
+// to the native HDR10 output (PQ, BT.2020): PQ kept; HLG and SDR to absolute light, then PQ (as video.frag)
+vec3 PostToHdr10(vec3 rgb, int transfer)
+{
+	if (transfer == kPostPq)
+		return rgb;
+	vec3 light;
+	if (transfer == kPostHlg)
+	{
+		light = vec3(PostHlgInvOetf(rgb.r), PostHlgInvOetf(rgb.g), PostHlgInvOetf(rgb.b));
+		light *= 1000.0 * pow(max(dot(light, vec3(0.2627, 0.6780, 0.0593)), 0.0), 0.2);
+	}
+	else
+	{
+		light = pow(rgb, vec3(2.4)) * 203.0;
+		light = vec3(dot(light, vec3(0.6274, 0.3293, 0.0433)), dot(light, vec3(0.0691, 0.9195, 0.0114)),
+			dot(light, vec3(0.0164, 0.0880, 0.8956)));
+	}
+	return vec3(PostPqInv(light.r), PostPqInv(light.g), PostPqInv(light.b));
+}
+
+// MPC-HC's colour controls on R'G'B' (codes, 0..1): brightness -1..1 (added), contrast 0..2 and saturation 0..2
+// (times; 1 leaves the picture as it is), around mid grey and the pixel's own luma
+vec3 PostColor(vec3 c, float brightness, float contrast, float saturation)
+{
+	const float y = dot(c, kLuma);
+	c = mix(vec3(y), c, saturation);
+	c = (c - 0.5) * contrast + 0.5 + brightness;
+	return clamp(c, 0.0, 1.0);
+}
+
+#endif
diff --git a/shaders/prep.comp b/shaders/prep.comp
new file mode 100644
index 0000000..a9eb743
--- /dev/null
+++ b/shaders/prep.comp
@@ -0,0 +1,153 @@
+// ps5-slang-gpu 1.2 (Media Player Classic PS5 1.7): pass 1 of the video post-processing, "prep" (docs/POST-PROCESSING.md
+// in the player's repository). Each pixel of a decoded picture, at the picture's own size:
+//   1. its planes read at their texel centres (the chroma bilinear where the stream sites it), the codes normalised;
+//   2. light deblocking and deringing of the luma (Options: Deblocking): across the 8x8 grid, a step between two blocks
+//      smaller than the texture around it smoothed (H.264's normal-strength rule: |p0 - q0| < alpha, |p1 - p0| < beta,
+//      |q1 - q0| < beta, the change at most tc); a pixel next to a strong edge kept within its neighbours' range;
+//   3. debanding (Options: Debanding): the approach of libplacebo's and f3kdb's (reimplemented, not copied): twice, the
+//      average of four pixels at a random angle and a growing radius taken where it differs from the pixel by less than
+//      the threshold, each component on its own; then a little noise to hide what is left of the steps;
+//   4. the colour matrix to R'G'B' (the stream's transfer and primaries kept: gamma, PQ or HLG codes), clipped to 0..1,
+//      written to the picture's slot of the ring (A2B10G10R10).
+// The same layouts and numbers as video.frag.
+//
+// SPDX-License-Identifier: MIT
+#version 450
+#extension GL_GOOGLE_include_directive : require
+#include "post_common.glsl"
+
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform sampler2D P0;
+layout(set = 0, binding = 1) uniform sampler2D P1;
+layout(set = 0, binding = 2) uniform sampler2D P2;
+layout(set = 0, binding = 3, rgb10_a2) uniform writeonly image2D Dst;
+
+layout(push_constant) uniform Pc
+{
+	vec4 norm;       // Y = v * norm.x + norm.y; C = v * norm.z + norm.w (v: the texture's value)
+	vec4 m0, m1, m2; // R', G', B' = dot(mN.xyz, (Y, Cb, Cr))
+	vec4 chroma;     // chroma texels per luma pixel (x, y), the chroma siting's offset in chroma texels (x, y)
+	ivec4 mode;      // layout, flags (1 deband, 2 deblock), packed RGB's swizzle (r | g << 2 | b << 4), the picture's number
+	vec4 band;       // deband threshold and grain (normalised codes), its radius (pixels), deblocking strength
+}
+pc;
+
+const int kPlanar = 0, kSemiUV = 1, kSemiVU = 2, kPacked = 3, kGray = 4, kPlanarGBR = 5;
+
+ivec2 gLsize, gCsize;
+
+vec4 Tex(sampler2D t, ivec2 p, ivec2 size)
+{
+	return texelFetch(t, clamp(p, ivec2(0), size - 1), 0);
+}
+
+// a chroma plane at a luma pixel's centre: bilinear between the chroma texels around it
+vec4 Chroma(sampler2D t, ivec2 p)
+{
+	const vec2 c = (vec2(p) + 0.5) * pc.chroma.xy + pc.chroma.zw - 0.5;
+	const vec2 f = fract(c);
+	const ivec2 i = ivec2(floor(c));
+	return mix(mix(Tex(t, i, gCsize), Tex(t, i + ivec2(1, 0), gCsize), f.x),
+		mix(Tex(t, i + ivec2(0, 1), gCsize), Tex(t, i + ivec2(1, 1), gCsize), f.x), f.y);
+}
+
+// the picture's three components at a pixel, normalised: (Y, Cb, Cr), or (R, G, B) for packed and planar GBR
+vec3 Codes(ivec2 p)
+{
+	const int lay = pc.mode.x;
+	const vec4 a = Tex(P0, p, gLsize);
+	if (lay == kPacked)
+	{
+		const int s = pc.mode.z;
+		return vec3(a[s & 3], a[(s >> 2) & 3], a[(s >> 4) & 3]);
+	}
+	if (lay == kPlanarGBR)
+		return clamp(vec3(Chroma(P2, p).r, a.r, Chroma(P1, p).r) * pc.norm.x + pc.norm.y, 0.0, 1.0);
+	vec2 cbcr = vec2(0.0);
+	if (lay == kPlanar)
+		cbcr = vec2(Chroma(P1, p).r, Chroma(P2, p).r);
+	else if (lay == kSemiUV || lay == kSemiVU)
+	{
+		const vec2 uv = Chroma(P1, p).rg;
+		cbcr = lay == kSemiUV ? uv : uv.yx;
+	}
+	return vec3(a.r * pc.norm.x + pc.norm.y, lay == kGray ? vec2(0.0) : cbcr * pc.norm.z + pc.norm.w);
+}
+
+float Luma(ivec2 p)
+{
+	return Tex(P0, p, gLsize).r * pc.norm.x + pc.norm.y;
+}
+
+// one block edge's filter for the pixel at index k (0..3 of p1 p0 | q0 q1); only p0 and q0 change
+float EdgeFilter(float p1, float p0, float q0, float q1, int k, float s)
+{
+	const float alpha = 0.06 * s, beta = 0.016 * s, tc = 0.02 * s;
+	if (k == 0 || k == 3 || abs(p0 - q0) >= alpha || abs(p1 - p0) >= beta || abs(q1 - q0) >= beta)
+		return k == 0 ? p1 : k == 1 ? p0 : k == 2 ? q0 : q1;
+	const float delta = clamp(((q0 - p0) * 4.0 + (p1 - q1)) / 8.0, -tc, tc);
+	return k == 1 ? p0 + delta : q0 - delta;
+}
+
+// the luma deblocked across the block edge beside it (each way), then kept within its neighbours' range near a strong edge
+float Deblock(ivec2 p, float y)
+{
+	const float s = pc.band.w;
+	for (int axis = 0; axis < 2; axis++)
+	{
+		const int c = axis == 0 ? p.x : p.y;
+		const int bx = c & 7;
+		if (bx != 7 && bx != 0)
+			continue;
+		const int b = bx == 0 ? c : c + 1; // the first pixel after the edge
+		if (b <= 0 || b >= (axis == 0 ? gLsize.x : gLsize.y))
+			continue;
+		const ivec2 d = axis == 0 ? ivec2(1, 0) : ivec2(0, 1);
+		const ivec2 o = axis == 0 ? ivec2(b, p.y) : ivec2(p.x, b);
+		y = EdgeFilter(Luma(o - 2 * d), Luma(o - d), Luma(o), Luma(o + d), bx == 7 ? 1 : 2, s) + (y - Luma(p));
+	}
+	// deringing: near a strong edge (the neighbours' range above 0.2), a lone overshoot is cut to that range
+	float lo = 1.0, hi = 0.0;
+	for (int j = -1; j <= 1; j++)
+		for (int i = -1; i <= 1; i++)
+			if (i != 0 || j != 0)
+			{
+				const float v = Luma(p + ivec2(i, j));
+				lo = min(lo, v);
+				hi = max(hi, v);
+			}
+	return hi - lo > 0.2 * s ? clamp(y, lo, hi) : y;
+}
+
+vec3 Deband(ivec2 p, vec3 c)
+{
+	const float thr = pc.band.x, radius = pc.band.z;
+	const uint seed = uint(pc.mode.w);
+	for (int it = 1; it <= 2; it++)
+	{
+		const float r = radius * float(it) * 0.5 * (0.25 + 0.75 * PostRand(uvec3(p, seed * 8u + uint(it))));
+		const float a = 6.2831853 * PostRand(uvec3(p, seed * 8u + uint(it) + 4u));
+		const ivec2 o1 = ivec2(round(vec2(cos(a), sin(a)) * r)), o2 = ivec2(-o1.y, o1.x);
+		const vec3 avg = (Codes(p + o1) + Codes(p - o1) + Codes(p + o2) + Codes(p - o2)) * 0.25;
+		c = mix(avg, c, greaterThanEqual(abs(avg - c), vec3(thr)));
+	}
+	return c + (PostRand(uvec3(p, seed * 8u + 7u)) - 0.5) * pc.band.y;
+}
+
+void main()
+{
+	gLsize = textureSize(P0, 0);
+	gCsize = textureSize(P1, 0);
+	const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+	if (p.x >= gLsize.x || p.y >= gLsize.y)
+		return;
+	const int lay = pc.mode.x;
+	const bool ycc = lay != kPacked && lay != kPlanarGBR;
+	vec3 c = Codes(p);
+	if ((pc.mode.y & 2) != 0 && ycc)
+		c.x = Deblock(p, c.x);
+	if ((pc.mode.y & 1) != 0)
+		c = Deband(p, c);
+	vec3 rgb = ycc ? vec3(dot(pc.m0.xyz, c), dot(pc.m1.xyz, c), dot(pc.m2.xyz, c)) : c;
+	imageStore(Dst, p, vec4(clamp(rgb, 0.0, 1.0), 1.0));
+}
diff --git a/shaders/pyr.comp b/shaders/pyr.comp
new file mode 100644
index 0000000..065e224
--- /dev/null
+++ b/shaders/pyr.comp
@@ -0,0 +1,47 @@
+// ps5-slang-gpu 1.2 (Media Player Classic PS5 1.7): motion smoothing's pyramid (docs/POST-PROCESSING.md). One level of a
+// picture's luma pyramid: from the picture itself (mode 0: its luma averaged over each output pixel's footprint, about a
+// quarter of its size, at most 960 pixels wide) or from the level above (mode 1: halved, a 2x2 average). R16_SFLOAT.
+// (gpu.cpp halves it while that leaves 15 pixels or more, at most 7 levels: 960 to 15 for a 4K picture.)
+//
+// SPDX-License-Identifier: MIT
+#version 450
+#extension GL_GOOGLE_include_directive : require
+#include "post_common.glsl"
+
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform sampler2D Src; // linear filtering, clamped
+layout(set = 0, binding = 1, r16f) uniform writeonly image2D Dst;
+
+layout(push_constant) uniform Pc
+{
+	ivec4 mode; // 0: from the picture, 1: from the level above; the output's width and height
+}
+pc;
+
+void main()
+{
+	const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+	const ivec2 out_size = pc.mode.yz;
+	if (p.x >= out_size.x || p.y >= out_size.y)
+		return;
+	const vec2 in_size = vec2(textureSize(Src, 0));
+	const vec2 f = in_size / vec2(out_size); // input pixels per output pixel
+	float acc = 0.0;
+	if (pc.mode.x == 1)
+		acc = textureLod(Src, (vec2(p) + 0.5) / vec2(out_size), 0.0).r; // the 2x2 under it, through the bilinear tap
+	else
+	{
+		// N x N bilinear taps over the footprint, each the average of the 2x2 texels around it
+		const ivec2 n = clamp(ivec2(ceil(f * 0.5)), ivec2(1), ivec2(4));
+		const vec2 step_ = f / vec2(n);
+		const vec2 base = vec2(p) * f;
+		for (int j = 0; j < n.y; j++)
+			for (int i = 0; i < n.x; i++)
+			{
+				const vec2 c = base + (vec2(i, j) + 0.5) * step_;
+				acc += dot(textureLod(Src, c / in_size, 0.0).rgb, kLuma);
+			}
+		acc /= float(n.x * n.y);
+	}
+	imageStore(Dst, p, vec4(acc, 0.0, 0.0, 0.0));
+}
diff --git a/shaders/scale.comp b/shaders/scale.comp
new file mode 100644
index 0000000..8e27478
--- /dev/null
+++ b/shaders/scale.comp
@@ -0,0 +1,81 @@
+// ps5-slang-gpu 1.2 (Media Player Classic PS5 1.7): the video post-processing's scaler other than FSR 1 (docs/
+// POST-PROCESSING.md): the picture to its rectangle on the display, bilinear (a tent), bicubic (Catmull-Rom) or Lanczos
+// (3 lobes), each widened by the shrink factor when the picture is made smaller (as video.frag does), the weights
+// normalised. Only the rectangle's part on the display is made (the output image's origin is that part's corner).
+//
+// SPDX-License-Identifier: MIT
+#version 450
+#extension GL_GOOGLE_include_directive : require
+#include "post_common.glsl"
+
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform sampler2D Src; // A2B10G10R10, nearest or linear: read at texel centres
+layout(set = 0, binding = 1, rgb10_a2) uniform writeonly image2D Dst;
+
+layout(push_constant) uniform Pc
+{
+	vec4 map;   // source pixels per output pixel (x, y); the visible part's corner in the rectangle (output pixels)
+	ivec4 mode; // 0 bilinear, 1 bicubic, 2 Lanczos; the visible part's width and height
+}
+pc;
+
+const float kPi = 3.14159265;
+
+float Kernel(float x, int m)
+{
+	x = abs(x);
+	if (m == 0)
+		return max(0.0, 1.0 - x);
+	if (m == 1)
+	{
+		if (x < 1.0)
+			return (1.5 * x - 2.5) * x * x + 1.0;
+		if (x < 2.0)
+			return ((-0.5 * x + 2.5) * x - 4.0) * x + 2.0;
+		return 0.0;
+	}
+	if (x < 1e-5)
+		return 1.0;
+	if (x >= 3.0)
+		return 0.0;
+	const float a = kPi * x;
+	return 3.0 * sin(a) * sin(a / 3.0) / (a * a);
+}
+
+void main()
+{
+	const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+	if (p.x >= pc.mode.y || p.y >= pc.mode.z)
+		return;
+	const int m = pc.mode.x;
+	const ivec2 size = textureSize(Src, 0);
+	const vec2 r = max(pc.map.xy, vec2(1.0)); // the kernel's widening when shrinking
+	const float support = m == 0 ? 1.0 : m == 1 ? 2.0 : 3.0;
+	// where this output pixel's centre falls in the source (texel centres at i + 0.5)
+	const vec2 c = (vec2(p) + pc.map.zw + 0.5) * pc.map.xy - 0.5;
+	const vec2 rr = min(r, vec2(m == 2 ? 2.0 : 4.0));
+	const vec2 lo = floor(c - support * rr) + 1.0, hi = floor(c + support * rr);
+	vec3 acc = vec3(0.0);
+	float wsum = 0.0;
+	for (int j = 0; j < 25; j++)
+	{
+		const float y = lo.y + float(j);
+		if (y > hi.y)
+			break;
+		const float wy = Kernel((y - c.y) / rr.y, m);
+		if (wy == 0.0)
+			continue;
+		for (int i = 0; i < 25; i++)
+		{
+			const float x = lo.x + float(i);
+			if (x > hi.x)
+				break;
+			const float w = Kernel((x - c.x) / rr.x, m) * wy;
+			if (w == 0.0)
+				continue;
+			acc += w * texelFetch(Src, clamp(ivec2(x, y), ivec2(0), size - 1), 0).rgb;
+			wsum += w;
+		}
+	}
+	imageStore(Dst, p, vec4(clamp(wsum != 0.0 ? acc / wsum : vec3(0.0), 0.0, 1.0), 1.0));
+}
diff --git a/shaders/warp.comp b/shaders/warp.comp
new file mode 100644
index 0000000..1dd8b48
--- /dev/null
+++ b/shaders/warp.comp
@@ -0,0 +1,105 @@
+// ps5-slang-gpu 1.2 (Media Player Classic PS5 1.7): motion smoothing's picture between two decoded ones, at the display's
+// time t (0: picture A, 1: picture B), at the pictures' own size (docs/POST-PROCESSING.md).
+//   - Each pixel's vectors to A and to B, from the two flows at its place (the linear approximation of Super SloMo, Jiang
+//     et al. 2018): F(t->0) = -(1 - t) t F01 + t^2 F10, F(t->1) = (1 - t)^2 F01 - t (1 - t) F10.
+//   - A and B sampled where those vectors point, blended by t and by occlusion: where a vector and the other way's
+//     vector at its end don't cancel (forward-backward consistency), that picture is mostly left out. Where neither
+//     way's vectors hold up (a motion beyond the flow's reach), the nearer picture as it is: never a cross-fade, which
+//     would show a double image.
+//   - A scene change (the coarsest level's mean difference above the threshold): no blend, the nearer picture.
+//
+// SPDX-License-Identifier: MIT
+#version 450
+#extension GL_GOOGLE_include_directive : require
+#include "post_common.glsl"
+
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform sampler2D I0;   // picture A (A2B10G10R10), linear, clamped
+layout(set = 0, binding = 1) uniform sampler2D I1;   // picture B
+layout(set = 0, binding = 2) uniform sampler2D F01;  // A -> B, the finest level (its pixels), linear
+layout(set = 0, binding = 3) uniform sampler2D F10;  // B -> A
+layout(set = 0, binding = 4) uniform sampler2D LowA; // the coarsest luma level of A
+layout(set = 0, binding = 5) uniform sampler2D LowB; // ... of B
+layout(set = 0, binding = 6, rgb10_a2) uniform writeonly image2D Dst;
+
+layout(push_constant) uniform Pc
+{
+	vec4 tune;  // t, the scene change threshold (mean luma difference), the occlusion's scale (flow pixels), 0
+	ivec4 size; // the pictures' width and height, the flow's width and height
+}
+pc;
+
+shared float sDiff[64];
+
+float SceneDiff()
+{
+	const ivec2 ls = textureSize(LowA, 0);
+	const int n = ls.x * ls.y;
+	float acc = 0.0;
+	for (int i = int(gl_LocalInvocationIndex); i < n; i += 64)
+	{
+		const ivec2 q = ivec2(i % ls.x, i / ls.x);
+		acc += abs(texelFetch(LowA, q, 0).r - texelFetch(LowB, q, 0).r);
+	}
+	sDiff[gl_LocalInvocationIndex] = acc;
+	barrier();
+	for (uint s = 32u; s > 0u; s >>= 1)
+	{
+		if (gl_LocalInvocationIndex < s)
+			sDiff[gl_LocalInvocationIndex] += sDiff[gl_LocalInvocationIndex + s];
+		barrier();
+	}
+	return sDiff[0] / float(max(n, 1));
+}
+
+// a vector at a place given in flow pixels
+vec2 Flow(sampler2D f, vec2 q, vec2 fsize)
+{
+	return textureLod(f, q / fsize, 0.0).rg;
+}
+
+void main()
+{
+	// every invocation takes part in the scene's reduction (barrier) before any returns
+	const float diff = SceneDiff();
+	const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+	const ivec2 size = pc.size.xy;
+	if (p.x >= size.x || p.y >= size.y)
+		return;
+	const float t = pc.tune.x;
+	const vec2 inv = 1.0 / vec2(size);
+	const vec2 pc_ = vec2(p) + 0.5;
+	if (diff > pc.tune.y)
+	{
+		imageStore(Dst, p, t < 0.5 ? textureLod(I0, pc_ * inv, 0.0) : textureLod(I1, pc_ * inv, 0.0));
+		return;
+	}
+	const vec2 fsize = vec2(pc.size.zw);
+	const vec2 to_flow = fsize / vec2(size), to_src = vec2(size) / fsize;
+	const vec2 q = pc_ * to_flow;
+	const vec2 f01 = Flow(F01, q, fsize), f10 = Flow(F10, q, fsize);
+	const vec2 ft0 = (-(1.0 - t) * t * f01 + t * t * f10);
+	const vec2 ft1 = ((1.0 - t) * (1.0 - t) * f01 - t * (1.0 - t) * f10);
+	// where the pixel comes from in A and in B (flow pixels), and how well each way's vectors agree there
+	const vec2 q0 = q + ft0, q1 = q + ft1;
+	const vec2 a01 = Flow(F01, q0, fsize), a10 = Flow(F10, q1, fsize);
+	const float e0 = length(a01 + Flow(F10, q0 + a01, fsize));
+	const float e1 = length(a10 + Flow(F01, q1 + a10, fsize));
+	const hf sigma = hf(pc.tune.z);
+	const hf v0 = hf(1.0) / (hf(1.0) + hf(e0) * hf(e0) / (sigma * sigma));
+	const hf v1 = hf(1.0) / (hf(1.0) + hf(e1) * hf(e1) / (sigma * sigma));
+	if (max(v0, v1) < hf(0.2)) // (both ways off by more than 2 flow pixels)
+	{
+		imageStore(Dst, p, t < 0.5 ? textureLod(I0, pc_ * inv, 0.0) : textureLod(I1, pc_ * inv, 0.0));
+		return;
+	}
+	const hf w0 = hf(1.0 - t) * v0, w1 = hf(t) * v1;
+	const hf3 c0 = hf3(textureLod(I0, (q0 * to_src) * inv, 0.0).rgb);
+	const hf3 c1 = hf3(textureLod(I1, (q1 * to_src) * inv, 0.0).rgb);
+	hf3 c;
+	if (w0 + w1 < hf(1e-3))
+		c = mix(c0, c1, hf(t));
+	else
+		c = (c0 * w0 + c1 * w1) / (w0 + w1);
+	imageStore(Dst, p, vec4(vec3(c), 1.0));
+}
