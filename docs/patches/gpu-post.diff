+	c.saturation = clampf(c.saturation, 0.0f, 2.0f, 1.0f);
+	if (int(c.scaler) < int(VideoScaler::Bilinear) || int(c.scaler) > int(VideoScaler::Fsr))
+		c.scaler = VideoScaler::Fsr;
