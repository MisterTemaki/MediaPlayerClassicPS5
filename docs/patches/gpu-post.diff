+	}
+	// debanding: a gentle ramp in 8 steps; turned on while the picture is paused, it is prepared again
+	{
+		const int w = kOutW, h = kOutH;
+		std::vector<uint8_t> y(size_t(w) * h), uv;
+		for (int j = 0; j < h; j++)
+			for (int i = 0; i < w; i++)
